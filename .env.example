# =========================================================================
# Vau-M Server & UI Port Configurations
# =========================================================================

# PORT (or VITE_API_PORT): The port where the Express API server runs
PORT=3001

# VITE_PORT: The port where the Vite React dev server dashboard runs
VITE_PORT=3000

# =========================================================================
# External Integration & Secrets (Optional)
# =========================================================================

# GEMINI_API_KEY: Required for vector search/embeddings in query.py
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL (for self-referential hooks, OAuth, and API callbacks)
APP_URL="MY_APP_URL"

# =========================================================================
# AI Session Explorer — Source Directories (Optional)
# Override these if your tools store sessions in non-standard locations.
# =========================================================================

# CLAUDE_SESSIONS_PATH=%USERPROFILE%\.claude\projects
# CODEX_SESSIONS_PATH=%USERPROFILE%\.codex\sessions
# CURSOR_SESSIONS_PATH=%APPDATA%\Cursor\User\workspaceStorage
# GEMINI_SESSIONS_PATH=%USERPROFILE%\.gemini\antigravity-ide\brain
# KILOCODE_SESSIONS_PATH=%APPDATA%\Code\User\globalStorage\kilocode.kilo-code\tasks

